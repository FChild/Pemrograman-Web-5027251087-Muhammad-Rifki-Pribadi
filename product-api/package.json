{
  "name": "product-api",
  "version": "3.0.0",
  "private": true,
  "description": "Manajemen Produk React dengan Express, Prisma, dan SQLite",
  "main": "app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/init-db.js && prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:studio": "prisma studio",
    "test": "node tests/integration.js",
    "build": "npm --prefix client run build",
    "dev:ui": "npm --prefix client run dev",
    "test:ui": "node tests/ui.cjs",
    "test:components": "node tests/components.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "16.6.1",
    "express": "4.21.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "prisma": "6.19.0"
  }
}
