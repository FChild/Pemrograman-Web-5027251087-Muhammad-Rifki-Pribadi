{
  "name": "product-api",
  "version": "2.0.0",
  "private": true,
  "description": "API produk ExpressJS dengan Prisma dan SQLite",
  "main": "app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/init-db.js && prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:studio": "prisma studio",
    "test": "node tests/integration.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "16.6.1",
    "express": "4.21.2"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
